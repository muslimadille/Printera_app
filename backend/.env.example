APP_NAME=Printera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Comma-separated list of allowed frontend origins for CORS (the SPA + mobile web).
FRONTEND_URLS=http://localhost:5173,http://localhost:8080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL recommended to match the current Supabase schema) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=printera
DB_USERNAME=printera
DB_PASSWORD=

# --- JWT (php-open-source-saver/jwt-auth). Generate with: php artisan jwt:secret ---
JWT_SECRET=
# 43200 minutes = 30 days, matching the "remember me" window in the SPA.
JWT_TTL=43200
JWT_REFRESH_TTL=43200

# --- Sessions / devices ---
IDLE_SESSION_HOURS=72

# --- Admin bootstrap (used ONLY by AdminSeeder; do NOT reuse legacy demo passwords) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Storage: montage-files replacement. local for dev, s3 for prod. ---
MONTAGE_DISK=local
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Voice AI provider (ports parse-voice-input). Keep server-side only. ---
VOICE_AI_BASE_URL=https://ai-gateway.lovable.dev/v1/chat/completions
VOICE_AI_MODEL=google/gemini-2.5-flash
VOICE_AI_API_KEY=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# ─── Supabase migration source (Phase 7 only — delete in Phase 8) ─────────────
# Read by app:migrate-from-supabase. Use the DIRECT connection string from
# Settings → Database, NOT the transaction pooler: the copy runs long transactions.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Read by app:migrate-supabase-storage. The service-role key bypasses bucket
# policies — it is a SECRET, belongs only on the migration operator's machine,
# and should be rotated once the copy is signed off.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=montage-files
