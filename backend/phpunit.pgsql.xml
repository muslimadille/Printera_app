<?xml version="1.0" encoding="UTF-8"?>
<!--
  BE-019: runs the suite against a real PostgreSQL instance.

  The default phpunit.xml uses in-memory SQLite, which cannot express the partial unique
  index on user_sessions, the jsonb column type and its {} default, or the
  session_events.event_type CHECK. PostgresSchemaTest asserts all three and skips itself
  under any other driver.

  Usage (the docker command to bring up a throwaway instance is in the PostgresSchemaTest
  class docblock; port 55432 avoids clashing with a locally installed Postgres):

    ./vendor/bin/phpunit -c phpunit.pgsql.xml

  Point DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD below at the team instance instead
  if you have one. On Windows, pdo_pgsql may need loading per command:
  php -d extension=pdo_pgsql ./vendor/bin/phpunit -c phpunit.pgsql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="55432" force="true"/>
        <env name="DB_DATABASE" value="printera" force="true"/>
        <env name="DB_USERNAME" value="printera" force="true"/>
        <env name="DB_PASSWORD" value="pw" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="JWT_SECRET" value="testing-only-secret-please-override-in-real-env-0000000000" force="true"/>
    </php>
</phpunit>
